    <!-- Scanner guides -->
    <string name="scan_guide_worker_title">☁️ Create Cloudflare Worker</string>
    <string name="scan_guide_worker_body">Step 1: Create API Token\n• Go to Cloudflare Dashboard\n• Profile → API Tokens → Create Token\n• Permissions needed:\n  - Workers Scripts / Edit\n  - Workers KV Storage / Edit\n  - D1 / Edit\n  - Workers Routes / Edit\n  - Account Settings / Read\n\nStep 2: Verify Email\n• Your Cloudflare email must be verified\n• Visit Workers and Pages at least once\n\nStep 3: Deploy Panel\n• Use one of the panel projects\n• Or use the Telegram bot for auto setup\n\n⚠️ After creating the panel, wait 1–2 minutes if the page is empty.</string>

    <string name="scan_guide_bot_title">🤖 Auto Setup Bot</string>
    <string name="scan_guide_bot_body">Use Telegram bot @CloudBPBot to auto-deploy your panel:\n\n• Enter your Cloudflare API Token\n• Choose panel type\n• Bot deploys everything automatically\n• Get your config link instantly\n\nThis is the easiest way to get started.</string>

